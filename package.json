{
  "name": "rlvo-public-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs && node scripts/prepare-brand.mjs",
    "audit:brand": "node scripts/audit-brand.mjs",
    "verify:legal": "node --experimental-strip-types scripts/verify-legal.ts",
    "normalize:legal": "node --experimental-strip-types scripts/normalize-legal.ts",
    "test:legal": "node --experimental-strip-types --test tests/legal-integrity.test.ts tests/legal-contract.test.ts",
    "audit:legal": "node --experimental-strip-types scripts/audit-legal.ts",
    "predev": "npm run assets",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "prebuild": "npm run verify:legal && npm run assets",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/audit-static.mjs && npm run audit:brand && npm run audit:legal",
    "build:preview": "SITE_ENV=preview npm run build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "compare:legal": "node --experimental-strip-types scripts/compare-legal-archive.ts",
    "test:legal:http": "node --experimental-strip-types scripts/audit-legal-http.ts",
    "test:ci": "node --test tests/ci-*.test.mjs",
    "ci:web": "node scripts/ci/verify-web.mjs",
    "qa:browsers": "node scripts/qa/browsers.mjs",
    "qa:smoke": "node scripts/qa/run.mjs smoke",
    "qa:full": "node scripts/qa/run.mjs full",
    "qa:lighthouse": "node scripts/qa/run.mjs lighthouse",
    "qa:report": "node scripts/qa/report.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "lighthouse": "13.6.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "yaml": "2.9.1"
  }
}
