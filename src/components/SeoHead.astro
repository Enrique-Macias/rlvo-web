---
import { site, pages, canonical, type PagePath } from '../config/site';
interface Props { page: PagePath }
const { page } = Astro.props;
const meta = pages[page];
const noindex = !meta.index || import.meta.env.SITE_ENV === 'preview';
---
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={canonical(page)} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.brand} />
<meta property="og:locale" content={site.ogLocale} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={canonical(page)} />
{site.seo.image && <><meta property="og:image" content={canonical(site.seo.image)} /><meta property="og:image:alt" content={site.seo.imageAlt ?? site.brand} /></>}
<meta name="theme-color" content="#F3F0EA" />
