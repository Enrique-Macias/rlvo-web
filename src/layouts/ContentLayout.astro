---
import BaseLayout from './BaseLayout.astro';
import { type PagePath } from '../config/site';
interface Props { page: PagePath; title: string; intro: string; label?: string; date?: string; toc?: { id: string; label: string }[]; draft?: boolean }
const { page, title, intro, label = 'Información', date, toc = [], draft = false } = Astro.props;
---
<BaseLayout page={page}>
  <div class="wrap content-page">
    <div class="content-heading"><a class="text-link back-link" href="/"><span aria-hidden="true">←</span> Inicio</a><p class="eyebrow">{label}</p><h1>{title}</h1><p class="intro">{intro}</p>{date && <p class="legal-date">Última actualización: <span>{date}</span></p>}</div>
    {draft && <aside class="draft-banner"><strong>Borrador pendiente de revisión</strong><p>Este documento contiene información por confirmar y debe revisarse antes de su publicación definitiva.</p></aside>}
    <div class:list={['content-grid', { 'with-toc': toc.length > 0 }]}>
      {toc.length > 0 && <nav class="contents-nav" aria-label="Índice del documento"><p>En esta página</p><ol>{toc.map(item => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ol></nav>}
      <div class="prose"><slot /></div>
    </div>
  </div>
</BaseLayout>
<style>
  .content-page { padding-bottom: 5rem; min-height: 65vh; }
  .content-heading { padding-block: 1.5rem 2.5rem; max-width: 850px; }
  .back-link { color: var(--ink-soft); font-size: .75rem; margin-bottom: 2rem; }
  .eyebrow { color: var(--brick); margin-bottom: 1.5rem; }
  h1 { font-size: clamp(3rem, 7vw, 5.5rem); }
  .intro { max-width: 640px; margin-top: 1.5rem; color: var(--ink-soft); font-size: 1rem; }
  .legal-date { margin-top: 1.5rem; font-size: .75rem; }
  .legal-date span { display: inline; overflow-wrap: anywhere; }
  .draft-banner { padding: 1.25rem 1.5rem; border: 1px solid var(--line); border-left: 3px solid var(--brick); margin-bottom: 3rem; max-width: 900px; }
  .draft-banner strong { font-size: .875rem; font-weight: 600; }
  .draft-banner p { font-size: .8125rem; color: var(--ink-soft); margin-top: .25rem; }
  .content-grid { max-width: 900px; }
  .with-toc { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 3rem; }
  .contents-nav { align-self: start; position: sticky; top: 2rem; }
  .contents-nav > p { font-size: .625rem; font-weight: 600; text-transform: uppercase; letter-spacing: .12em; margin-bottom: .5rem; }
  .contents-nav ol { list-style: none; margin: 0; padding: 0; }
  .contents-nav a { display: flex; min-height: 44px; align-items: center; padding-block: .5rem; font-size: .75rem; text-decoration: none; color: var(--ink-soft); }
  .contents-nav a:hover { color: var(--brick); }
  .prose { max-width: 680px; min-width: 0; }
  .prose :global(section) { margin-bottom: 2.5rem; scroll-margin-top: 2rem; }
  .prose :global(h2) { font-size: 1.9rem; margin-bottom: 1.25rem; letter-spacing: -.035em; }
  .prose :global(h3) { font-size: 1rem; font-weight: 600; margin-block: 1.5rem .75rem; }
  .prose :global(p + p) { margin-top: 1rem; }
  .prose :global(p), .prose :global(li) { font-size: .9375rem; line-height: 1.85; }
  .prose :global(ul) { padding-left: 1.25rem; list-style: disc; }
  .prose :global(li) { margin-bottom: .75rem; }
  .prose :global(a:not(.email-link)) { text-decoration: underline; text-underline-offset: .25em; }
  .prose :global(.pending) { font-size: .8125rem; }
  .prose :global(details) { border-top: 1px solid var(--line); padding-block: .5rem; }
  .prose :global(summary) { cursor: pointer; padding-block: .8rem; font-size: .9375rem; font-weight: 500; }
  .prose :global(details p) { padding-bottom: 1rem; color: var(--ink-soft); }
  @media (max-width: 767px) { .content-page { padding-bottom: 3rem; } .with-toc { grid-template-columns: 1fr; gap: 2rem; } .contents-nav { position: static; border-bottom: 1px solid var(--line); padding-bottom: 1rem; } .contents-nav ol { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; } .legal-date span { display: block; margin-top: .4rem; } }
</style>
