---
import '../styles/global.css';
import { site, type PagePath, type PageMetadata } from '../config/site';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CloudflareWebAnalytics from '../components/CloudflareWebAnalytics.astro';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import frauncesFont from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
interface Props { page: PagePath; seo?: PageMetadata }
const { page, seo } = Astro.props;
---
<!doctype html>
<html lang={site.locale}>
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><SeoHead page={page} seo={seo} /><link rel="icon" href={site.brandAssets.favicon} type="image/svg+xml" /><link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin /><link rel="preload" href={frauncesFont} as="font" type="font/woff2" crossorigin /></head>
  <body id="inicio">
    <a class="skip-link" href="#contenido-principal">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido-principal" tabindex="-1"><slot /></main>
    <SiteFooter />
    <CloudflareWebAnalytics />
  </body>
</html>
